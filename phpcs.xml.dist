<?xml version="1.0"?>
<ruleset name="Yassin AI Assistant engineering standard">
    <description>PSR-12 structure plus WordPress security and database correctness.</description>
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="4"/>
    <config name="minimum_supported_wp_version" value="6.9"/>

    <file>src</file>
    <file>yassin-ai-assistant.php</file>
    <file>uninstall.php</file>

    <exclude-pattern>src/Application/Contract/GeneratedPublicApiContract.php</exclude-pattern>

    <rule ref="PSR12"/>
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.DirectDatabaseQuery"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
    <rule ref="WordPress.PHP.StrictInArray"/>
</ruleset>
